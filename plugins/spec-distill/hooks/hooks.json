{
  "description": "spec-distill — Stop hook (discovery + Layer 1 structural validation + reviewer dispatch), SessionEnd cleanup.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/review-dispatch.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/session-end-cleanup.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
